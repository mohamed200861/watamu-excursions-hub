# Copy to .env locally. On Cloudflare: Workers & Pages → project → Settings → Variables and Secrets.
# All values below are PUBLIC (safe in the browser). No secret is needed by this site.

# ===== BUILD variables (embedded in the bundle at build time) =====
VITE_SITE_URL=https://ecotoursandsafaris.it
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ===== RUNTIME variables (read by the server/Worker on each request) =====
# Same public values as above. If missing, the server falls back to the build values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
