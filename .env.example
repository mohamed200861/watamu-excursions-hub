# Copy to .env locally. On Cloudflare: Settings → Variables and Secrets.

# ===== PUBBLICHE (Build variables + Runtime variables) =====
# Safe in the browser; VITE_* are embedded at build time.
VITE_SITE_URL=https://ecotoursandsafaris.it
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Same public values read by the server at runtime
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ===== SEGRETE (Runtime "Secret" type only, never commit) =====
# Needed only to add a second administrator from /admin → Account.
SUPABASE_SERVICE_ROLE_KEY=
