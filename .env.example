# Copy to .env locally; on Cloudflare set these as build variables (Settings → Variables and Secrets).
# Public final address (no trailing slash, no www)
VITE_SITE_URL=https://ecotoursandsafaris.it
# Backend public (publishable) values – safe in the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-only (runtime secrets on Cloudflare, never commit)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
